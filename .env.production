# Quotation form receiver (Google Apps Script web app).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so this
# URL is visible to anyone who views source. That is inherent to a static site
# and is why it is committed rather than kept as a secret — treat the endpoint
# as public and do the validation inside the Apps Script itself.
NEXT_PUBLIC_QUOTE_ENDPOINT=https://script.google.com/macros/s/AKfycbyu4F40JPnm-xSwmh8b_EB7TEqlHbh7p_St1Lrx-HKna8aL1K1JpYV8pitTrBPwJLSDfA/exec
